{
  "name": "@crdt-rfd/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/alchemy/bin/alchemy.js dev --profile crdt-rfd --env-file ../../apps/web/.env",
    "deploy": "bun alchemy deploy --profile crdt-rfd --env-file ../../apps/web/.env.production",
    "destroy": "bun alchemy destroy --profile crdt-rfd --env-file ../../apps/web/.env.production",
    "plan": "bun alchemy deploy --profile crdt-rfd --env-file ../../apps/web/.env.production --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.94",
    "@effect/platform-node": "4.0.0-beta.94",
    "alchemy": "2.0.0-beta.61",
    "effect": "4.0.0-beta.94"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "1.3.14",
    "better-sqlite3": "^12.2.0",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
